# Copia este archivo como .env.local y agrega la clave solo en tu equipo o en los secretos del hosting.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-terra

# URL que muestra la guía para conectar el MCP remoto. Puede mantenerse así al publicar en Vercel.
NEXT_PUBLIC_MCP_URL=https://yol1-product-growth-lab.vercel.app/api/mcp
NEXT_PUBLIC_SITE_URL=https://yol1-product-growth-lab.vercel.app

# Postgres compartido para feedback y estado aislado de Cuentas Claras (Vercel Marketplace → Neon).
# Es obligatorio en producción: el módulo falla cerrado si falta, para no perder links entre instancias.
DATABASE_URL=

# Cuentas Claras — siempre parte con proveedor simulado y sin dinero real.
# En desarrollo local el simulador está habilitado; fuera de desarrollo exige true explícito.
DEBT_CENTER_SIMULATOR_ENABLED=false
# No existen credenciales ni selector de proveedor: el runtime usa siempre MockFloid.
# Los endpoints y estados del proveedor se documentan sólo como contrato futuro.
# Cada sesión demo expira tras 7 días sin actividad. El agregado tiene techo total de 900 KiB
# y reserva 100 KiB por cada pago demo activo, para guardar siempre sus cierres terminales.

# Clave larga y privada para entrar a /review. No reutilices una contraseña personal.
YOL1_REVIEW_TOKEN=

# Opcional: orígenes extra separados por coma. El mismo origen se permite automáticamente.
YOL1_FEEDBACK_ALLOWED_ORIGIN=

# Sal aleatoria para no guardar IP ni user-agent crudos en el límite del piloto MCP.
YOL1_PROJECT_HASH_SALT=
